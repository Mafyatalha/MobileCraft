name: Build APK
on:
push:
branches:
- main
jobs:
build:
runs-on: ubuntu-latest
steps:
- name: Checkout code
uses: actions/checkout@v2
- name: Build with Buildozer
uses: ArtemSBulgakov/buildozer-action@v1
with:
buildozer_version: latest
- name: Upload APK
uses: actions/upload-artifact@v2
with:
name: MobileCraft
path: bin/*.apk
